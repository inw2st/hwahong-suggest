# PostgreSQL
# Azure PostgreSQL 예시:
# DATABASE_URL=postgresql://username:password@your-server.postgres.database.azure.com:5432/suggestions?sslmode=require
DATABASE_URL=postgresql://user:password@db-host:5432/suggestions

# Security
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Public site URL
CORS_ORIGINS=https://your-domain.com
PUBLIC_BASE_URL=https://your-domain.com

# VAPID Keys (Push 알림용)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMTP (선택)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=화홍고 학생회 건의함
SMTP_REPLY_TO_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Caddy / Docker Compose
APP_HOST=your-domain.com

# 앱 시작 시 테이블 자동 생성
AUTO_CREATE_TABLES=true
